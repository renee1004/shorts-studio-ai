# App
NODE_ENV=development
# demo: 외부 Key 없이 Mock Provider로 동작 / live: 실제 API 사용
APP_MODE=demo
LOG_LEVEL=info

# Database
# 마이그레이션·시드·시스템 기록용(테이블 소유자)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/shorts_os
# 사용자 요청용. 테이블 소유자가 아닌 역할이어야 RLS가 실제로 적용된다.
# app_user는 pnpm db:migrate가 자동으로 만듭니다.
DATABASE_APP_URL=postgresql://app_user:app_user@127.0.0.1:5432/shorts_os
# local: auth 스키마 shim 적용 / supabase: 건너뜀
DB_TARGET=local

# Auth
# demo: 로컬 세션 쿠키 / supabase: Supabase Auth (아래 값 필요)
AUTH_PROVIDER=demo
AUTH_SESSION_SECRET=change-me-to-a-long-random-string

# Supabase (AUTH_PROVIDER=supabase일 때만)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# YouTube public discovery (APP_MODE=live일 때 필요)
YOUTUBE_API_KEY=
# 2026-06 이후 search.list는 하루 호출 수로 관리된다. 값은 콘솔에서 확인 후 조정한다.
YOUTUBE_SEARCH_DAILY_LIMIT=100
YOUTUBE_UNITS_DAILY_LIMIT=10000
YOUTUBE_CACHE_TTL_MINUTES=360

# Provider 공통
PROVIDER_TIMEOUT_MS=15000
PROVIDER_MAX_ATTEMPTS=3

# Gemini (Phase 2A Research Brain)
# 없으면 Demo Mode에서 Mock Research Provider가 쓰인다. Mock은 출처를 만들지 않는다.
GEMINI_API_KEY=
# 모델명은 코드에 고정하지 않는다. 콘솔에서 사용 가능한 이름을 넣는다.
GEMINI_RESEARCH_MODEL=

# Feature Flag 재정의 (JSON). Phase에 도달하지 않은 플래그는 강제로 꺼진다.
# 예: {"youtubeDiscovery":true}
FEATURE_FLAGS_OVERRIDE=
