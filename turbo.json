{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": [
    "NODE_ENV",
    "APP_MODE",
    "DATABASE_URL",
    "DATABASE_APP_URL",
    "AUTH_PROVIDER",
    "AUTH_SESSION_SECRET",
    "FEATURE_FLAGS_OVERRIDE",
    "YOUTUBE_API_KEY",
    "GEMINI_API_KEY",
    "LOG_LEVEL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "cache": false
    }
  }
}
