{
  "name": "shorts-intelligence-os",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "vitest run",
    "test:integration": "pnpm --filter @shorts-os/services test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup": "pnpm db:migrate && pnpm db:seed",
    "db:migrate": "pnpm --filter @shorts-os/db db:migrate",
    "db:seed": "pnpm --filter @shorts-os/services db:seed",
    "db:reset": "pnpm --filter @shorts-os/db db:reset",
    "render": "node apps/worker/scripts/render-short.mjs"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
