{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/v1/workspaces/[workspaceId]/niches",
      "regex": "^/api/v1/workspaces/([^/]+?)/niches(?:/)?$",
      "routeKeys": {
        "nxtPworkspaceId": "nxtPworkspaceId"
      },
      "namedRegex": "^/api/v1/workspaces/(?<nxtPworkspaceId>[^/]+?)/niches(?:/)?$"
    },
    {
      "page": "/api/v1/workspaces/[workspaceId]/niches/[nicheId]/collect",
      "regex": "^/api/v1/workspaces/([^/]+?)/niches/([^/]+?)/collect(?:/)?$",
      "routeKeys": {
        "nxtPworkspaceId": "nxtPworkspaceId",
        "nxtPnicheId": "nxtPnicheId"
      },
      "namedRegex": "^/api/v1/workspaces/(?<nxtPworkspaceId>[^/]+?)/niches/(?<nxtPnicheId>[^/]+?)/collect(?:/)?$"
    },
    {
      "page": "/api/v1/workspaces/[workspaceId]/runs",
      "regex": "^/api/v1/workspaces/([^/]+?)/runs(?:/)?$",
      "routeKeys": {
        "nxtPworkspaceId": "nxtPworkspaceId"
      },
      "namedRegex": "^/api/v1/workspaces/(?<nxtPworkspaceId>[^/]+?)/runs(?:/)?$"
    },
    {
      "page": "/api/v1/workspaces/[workspaceId]/topics",
      "regex": "^/api/v1/workspaces/([^/]+?)/topics(?:/)?$",
      "routeKeys": {
        "nxtPworkspaceId": "nxtPworkspaceId"
      },
      "namedRegex": "^/api/v1/workspaces/(?<nxtPworkspaceId>[^/]+?)/topics(?:/)?$"
    },
    {
      "page": "/api/v1/workspaces/[workspaceId]/topics/bulk-decision",
      "regex": "^/api/v1/workspaces/([^/]+?)/topics/bulk\\-decision(?:/)?$",
      "routeKeys": {
        "nxtPworkspaceId": "nxtPworkspaceId"
      },
      "namedRegex": "^/api/v1/workspaces/(?<nxtPworkspaceId>[^/]+?)/topics/bulk\\-decision(?:/)?$"
    },
    {
      "page": "/api/v1/workspaces/[workspaceId]/topics/[topicId]/decision",
      "regex": "^/api/v1/workspaces/([^/]+?)/topics/([^/]+?)/decision(?:/)?$",
      "routeKeys": {
        "nxtPworkspaceId": "nxtPworkspaceId",
        "nxtPtopicId": "nxtPtopicId"
      },
      "namedRegex": "^/api/v1/workspaces/(?<nxtPworkspaceId>[^/]+?)/topics/(?<nxtPtopicId>[^/]+?)/decision(?:/)?$"
    },
    {
      "page": "/playbook/steps/[slug]",
      "regex": "^/playbook/steps/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/playbook/steps/(?<nxtPslug>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
